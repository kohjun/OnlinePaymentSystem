config.stopBubbling = true

# Marks Lombok-generated getters, setters, equals, hashCode, toString and
# builders with @lombok.Generated so JaCoCo excludes them. Without this, the
# 109 main classes using Lombok annotations report their generated members as
# uncovered branches.
lombok.addLombokGeneratedAnnotation = true

# Copies @Qualifier from final fields onto the @RequiredArgsConstructor parameter.
# Without it the annotation is silently ignored and Spring injects the @Primary
# ObjectMapper where the Redis mapper was intended.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
