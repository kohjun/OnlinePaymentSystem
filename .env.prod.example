SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://db.production.internal:5432/everysale
DATABASE_USERNAME=everysale_app
DATABASE_PASSWORD=replace-with-secret-manager-reference
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka-1.production.internal:9092,kafka-2.production.internal:9092
TEMPORAL_TARGET=temporal.production.internal:7233
TEMPORAL_NAMESPACE=everysale

OIDC_ISSUER_URI=https://identity.example.com/realms/everysale
OIDC_AUDIENCE=everysale-api
EVERYSALE_TENANT_ID=everysale
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

TOSS_CLIENT_KEY=live_ck_replace_me
TOSS_SECRET_KEY=live_sk_replace_me
