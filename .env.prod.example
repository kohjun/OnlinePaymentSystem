SPRING_PROFILES_ACTIVE=prod

DATABASE_URL=jdbc:postgresql://db.production.internal:5432/everysale
DATABASE_USERNAME=everysale_app
DATABASE_PASSWORD=replace-with-secret-manager-reference
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka-1.production.internal:9092,kafka-2.production.internal:9092
TEMPORAL_TARGET=temporal.production.internal:7233
TEMPORAL_NAMESPACE=everysale

OIDC_ISSUER_URI=https://identity.example.com/realms/everysale
OIDC_AUDIENCE=everysale-api
OIDC_AUTHORIZATION_URI=https://identity.example.com/realms/everysale/protocol/openid-connect/auth
OIDC_TOKEN_URI=https://identity.example.com/realms/everysale/protocol/openid-connect/token
OIDC_CLIENT_ID=everysale-web
OIDC_SCOPES=openid,profile,email
EVERYSALE_TENANT_ID=everysale
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# 상품 이미지와 판매자 증빙은 공개 ACL을 사용하지 않는 S3 호환 버킷에 저장한다.
# AWS에서는 access key를 비우고 workload identity/instance role을 사용한다.
MEDIA_STORAGE_PROVIDER=S3
MEDIA_S3_BUCKET=everysale-private-media
MEDIA_S3_REGION=ap-northeast-2
MEDIA_S3_KEY_PREFIX=listing-media
MEDIA_S3_ENCRYPTION=AES256
MEDIA_S3_KMS_KEY_ID=
MEDIA_S3_ENDPOINT=
MEDIA_S3_PATH_STYLE_ACCESS=false
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=

# 업로드는 비공개 저장소에 기록되기 전에 ClamAV INSTREAM 검사를 통과해야 한다.
MEDIA_MALWARE_SCAN_PROVIDER=CLAMAV
MEDIA_MALWARE_SCAN_VALIDATE_ON_STARTUP=true
MEDIA_CLAMAV_HOST=clamav.production.internal
MEDIA_CLAMAV_PORT=3310
MEDIA_CLAMAV_CONNECT_TIMEOUT_MS=2000
MEDIA_CLAMAV_READ_TIMEOUT_MS=30000

TOSS_CLIENT_KEY=live_ck_replace_me
TOSS_SECRET_KEY=live_sk_replace_me
TOSS_WEBHOOK_PATH_TOKEN=replace-with-at-least-32-random-characters

# TOSS_PAYOUTS로 두면 실제 송금 어댑터가 활성화되고 LEDGER_ONLY 스텁은
# 비활성화된다. 지급대행 키는 수납용 TOSS_SECRET_KEY와 분리해서 관리한다.
PAYOUT_TRANSFER_PROVIDER=TOSS_PAYOUTS
PAYOUT_TRANSFER_ADAPTER_ENABLED=true
PAYOUT_TOSS_SECRET_KEY=live_sk_replace_me
PAYOUT_TOSS_BASE_URL=https://api.tosspayments.com
PAYOUT_TOSS_MODE=live
